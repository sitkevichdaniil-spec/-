// ============================================================
// 8. Геометрические фигуры
// ============================================================
abstract class Shape {
  double area();
}

class Rectangle extends Shape {
  double w, h;
  Rectangle(this.w, this.h);
  @override double area() => w * h;
}

class Triangle extends Shape {
  double base, height;
  Triangle(this.base, this.height);
  @override double area() => 0.5 * base * height;
}

class Circle extends Shape {
  double r;
  Circle(this.r);
  @override double area() => 3.14 * r * r;
}
// ============================================================
// 9. Перевод между системами счисления
// ============================================================
class NumConverter {
  static String convert(String number, int fromBase, int toBase) {
    int decimal = int.parse(number, radix: fromBase);
    return decimal.toRadixString(toBase);
  }
}
// ============================================================
// 10. Контейнер фигур с поиском максимальной площади
// ============================================================
class ShapeContainer {
  List<Shape> shapes = [];
  void add(Shape s) => shapes.add(s);

  Shape? findMaxArea() {
    if (shapes.isEmpty) return null;
    return shapes.reduce((a, b) => a.area() > b.area() ? a : b);
  }
}
