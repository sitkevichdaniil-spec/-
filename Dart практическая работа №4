// 11. Стол и столовые приборы
// ============================================================
abstract class Tableware {
  String name;
  Tableware(this.name);
}

class Plate extends Tableware { Plate() : super('Тарелка'); }
class Fork extends Tableware { Fork() : super('Вилка'); }
class Spoon extends Tableware { Spoon() : super('Ложка'); }

class Table {
  List<Tableware> items = [];
  void place(Tableware t) => items.add(t);
  void remove(Tableware t) => items.remove(t);
  void show() => print('На столе: ${items.map((e) => e.name).toList()}');
}
