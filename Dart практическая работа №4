// ============================================================
// 2. Шкаф с системами хранения
// ============================================================
class Storage {
  String name;
  List<String> items = [];
  Storage(this.name);
}
class Wardrobe {
  List<Storage> sections = [];
  Wardrobe(List<String> names) {
    sections = names.map((n) => Storage(n)).toList();
  }
  void put(String item, String section) {
    sections.firstWhere((s) => s.name == section).items.add(item);
  }
  bool take(String item, String section) {
    return sections.firstWhere((s) => s.name == section).items.remove(item);
  }
}

// ============================================================
// 3. Гриф и Блин
// ============================================================
class WeightPlate {
  double weight;
  WeightPlate(this.weight);
}

class Barbell {
  double maxLoad;
  List<WeightPlate> left = [];
  List<WeightPlate> right = [];
  Barbell(this.maxLoad);

  double get totalWeight =>
      [...left, ...right].fold(0.0, (sum, p) => sum + p.weight);

  bool addPlate(WeightPlate plate, bool isLeft) {
    if (totalWeight + plate.weight > maxLoad) return false;
    isLeft ? left.add(plate) : right.add(plate);
    return true;
  }
}
// ============================================================
// 4. Конвертер валют
// ============================================================
class CurrencyConverter {
  // курсы относительно базовой валюты
  Map<String, double> rates;
  CurrencyConverter(this.rates);

  double convert(double amount, String from, String to) {
    double inBase = amount / (rates[from] ?? 1);
    return inBase * (rates[to] ?? 1);
  }
}
// ============================================================
// 6. Перегрузка базовых арифметических операций
// ============================================================
class CustomNumber {
  int value;
  CustomNumber(this.value);

  CustomNumber operator +(CustomNumber o) => CustomNumber(value + o.value);
  CustomNumber operator -(CustomNumber o) => CustomNumber(value - o.value);
  CustomNumber operator *(CustomNumber o) => CustomNumber(value * o.value);
  CustomNumber operator /(CustomNumber o) => CustomNumber(value ~/ o.value);

  @override
  String toString() => '$value';
}
